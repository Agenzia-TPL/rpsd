# Coordination overrides: all services on rpsd-network.
# Applied on top of rpsd-ingest/.env.development by setup.sh.
# Uncomment forwarding/consumer lines if these subsystems are enabled.
# FORWARD__KAFKA__BOOTSTRAP_SERVERS=kafka:9092
# FORWARD__RABBITMQ__URL=amqp://guest:guest@rabbitmq:5672/
# CONSUMER__KAFKA__BOOTSTRAP_SERVERS=kafka:9092
# CONSUMER__RABBITMQ__URL=amqp://guest:guest@rabbitmq:5672/
# PREFECT_API_URL=http://prefect:4200/api
# EXCHANGE_AGREEMENT__FLOW_PROFILE_URL=http://rpsd-config:8000/exchange_agreement/api/v1/contracts/{contract_code}/flow-profile
