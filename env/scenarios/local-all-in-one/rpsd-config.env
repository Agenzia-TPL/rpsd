# Coordination overrides: all services on rpsd-network.
# Applied on top of rpsd-config/.env.development by setup.sh.
DATABASES__default__HOST=config-db
DATABASES__default__PORT=5432
EXTERNAL_PORT=20100
ALLOWED_HOSTS=["localhost", "127.0.0.1", "[::1]", "client.localhost", "rpsd-config", "host.docker.internal"]
KEYCLOAK_DISCOVERY_URL=http://keycloak:8080/realms/rpsd/.well-known/openid-configuration
OIDC_AUTHORIZATION_ENDPOINT_URL=http://localhost:19300/realms/rpsd/protocol/openid-connect/auth
OIDC_ISSUER_URL=http://localhost:19300/realms/rpsd
KEYCLOAK_ADMIN_REALM=rpsd
CONFIG_ASSETS_STORAGE_PROVIDER=fs
CONFIG_ASSETS_STORAGE_FS_BASE_PATH=/tmp/rpsd-config-assets
CONFIG_ASSETS_RABBITMQ_URL=amqp://guest:guest@rabbitmq/
CONFIG_ASSETS_RABBITMQ_EXCHANGE_TYPE=topic
TRANSPORT__RABBITMQ__URL=amqp://guest:guest@rabbitmq/
STORAGE__FS__BASE_PATH=/tmp/rpsd-config-assets
