# Coordination overrides: all services on rpsd-network.
# Applied on top of rpsd-config/.env.development by setup.sh.
DATABASES__default__HOST=config-db
DATABASES__default__PORT=5432
EXTERNAL_PORT=20100
ALLOWED_HOSTS=["localhost", "127.0.0.1", "[::1]", "client.localhost", "rpsd-config", "host.docker.internal"]
KEYCLOAK_DISCOVERY_URL=http://keycloak:8080/realms/rapsodia/.well-known/openid-configuration
