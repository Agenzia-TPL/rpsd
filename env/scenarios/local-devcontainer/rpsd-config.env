# Coordination overrides: service in devcontainer, shared infra on host.
# Applied on top of rpsd-config/.env.development by setup.sh.
DATABASES__default__HOST=host.docker.internal
DATABASES__default__PORT=20140
KEYCLOAK_ADMIN_BASE_URL=http://host.docker.internal:19300
KEYCLOAK_ADMIN_REALM=rpsd
KEYCLOAK_DISCOVERY_URL=http://host.docker.internal:19300/realms/rpsd/.well-known/openid-configuration
OIDC_AUTHORIZATION_ENDPOINT_URL=http://localhost:19300/realms/rpsd/protocol/openid-connect/auth
OIDC_ISSUER_URL=http://localhost:19300/realms/rpsd
KEYCLOAK_ADMIN_REALM=rpsd
CONFIG_ASSETS_STORAGE_PROVIDER=fs
CONFIG_ASSETS_STORAGE_FS_BASE_PATH=/tmp/rpsd-config-assets
CONFIG_ASSETS_RABBITMQ_URL=amqp://guest:guest@host.docker.internal:19100/
CONFIG_ASSETS_RABBITMQ_EXCHANGE_TYPE=topic
TRANSPORT__RABBITMQ__URL=amqp://guest:guest@host.docker.internal:19100/
STORAGE__FS__BASE_PATH=/tmp/rpsd-config-assets
