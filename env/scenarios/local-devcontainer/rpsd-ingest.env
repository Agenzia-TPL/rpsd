# Coordination overrides: service in devcontainer, shared infra on host.
# Applied on top of rpsd-ingest/.env.development by setup.sh.
# FORWARD__KAFKA__BOOTSTRAP_SERVERS=host.docker.internal:19000
# FORWARD__RABBITMQ__URL=amqp://guest:guest@host.docker.internal:19100/
# CONSUMER__KAFKA__BOOTSTRAP_SERVERS=host.docker.internal:19000
# CONSUMER__RABBITMQ__URL=amqp://guest:guest@host.docker.internal:19100/
# PREFECT_API_URL=http://host.docker.internal:19200/api
# EXCHANGE_AGREEMENT__TOKEN_URL=http://host.docker.internal:19300/realms/rpsd/protocol/openid-connect/token
# EXCHANGE_AGREEMENT__FLOW_PROFILE_URL=http://host.docker.internal:20100/exchange_agreement/api/v1/contracts/{contract_code}/flow-profile
# JWT_AUTH__ENABLED=true
# JWT_AUTH__ISSUER_URL=http://host.docker.internal:19300/realms/rpsd
# JWT_AUTH__AUDIENCE=rpsd-ingest
# JWT_AUTH__JWKS_URL=http://host.docker.internal:19300/realms/rpsd/protocol/openid-connect/certs
# CONFIG_AUTHZ__URL=http://host.docker.internal:20100/internal/authz/check
# CONFIG_AUTHZ__TOKEN_URL=http://host.docker.internal:19300/realms/rpsd/protocol/openid-connect/token
# CONFIG_AUTHZ__CLIENT_ID=rpsd-ingest
# CONFIG_AUTHZ__CLIENT_SECRET=change-me
# CONFIG_AUTHZ__AUDIENCE=rpsd-config-internal
