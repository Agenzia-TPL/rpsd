# .env.compose.images.open.example
# Image references for open mode (default — public images, works out of the box).
# Copy to rpsd/.env (or append to it) via: scripts/setup.sh

# --- Shared infrastructure ---
RPSD_IMAGE_KAFKA=apache/kafka:latest
RPSD_IMAGE_KAFKA_UI=provectuslabs/kafka-ui:latest
RPSD_IMAGE_SCHEMA_REGISTRY=confluentinc/cp-schema-registry:latest
RPSD_IMAGE_RABBITMQ=rabbitmq:3-management-alpine
RPSD_IMAGE_PREFECT=prefecthq/prefect:3.7.0-python3.14
RPSD_IMAGE_PREFECT_DB=postgres:17
RPSD_IMAGE_PREFECT_REDIS=redis:8-alpine
RPSD_IMAGE_KEYCLOAK=quay.io/keycloak/keycloak:26.3
RPSD_IMAGE_KEYCLOAK_DB=postgres:17
RPSD_IMAGE_CONFIG_DB=rpsd-config-db:local

# --- Application services (local build by default) ---
RPSD_IMAGE_INGEST=rpsd-ingest:local
RPSD_IMAGE_CONFIG=rpsd-config:local
