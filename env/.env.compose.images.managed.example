# .env.compose.images.managed.example
# Template for managed mode — integrators fill in their private registry references.
# Copy to rpsd/.env and update with your registry URLs.

# --- Shared infrastructure (mirrored to private registry) ---
RPSD_IMAGE_KAFKA=registry.example.com/rpsd/kafka:3.7.0
RPSD_IMAGE_KAFKA_UI=registry.example.com/rpsd/kafka-ui:v0.7.2
RPSD_IMAGE_SCHEMA_REGISTRY=registry.example.com/rpsd/cp-schema-registry:7.6.0
RPSD_IMAGE_RABBITMQ=registry.example.com/rpsd/rabbitmq:3.13-management-alpine
RPSD_IMAGE_PREFECT=registry.example.com/rpsd/prefect:3.0.0
RPSD_IMAGE_PREFECT_DB=registry.example.com/rpsd/postgres:17
RPSD_IMAGE_PREFECT_REDIS=registry.example.com/rpsd/redis:8-alpine
RPSD_IMAGE_KEYCLOAK=registry.example.com/rpsd/keycloak:26.3
RPSD_IMAGE_KEYCLOAK_DB=registry.example.com/rpsd/postgres:17
RPSD_IMAGE_CONFIG_DB=registry.example.com/rpsd/postgis:17-3.5

# --- Application services (built and pushed by CI) ---
RPSD_IMAGE_INGEST=registry.example.com/rpsd/rpsd-ingest:latest
RPSD_IMAGE_CONFIG=registry.example.com/rpsd/rpsd-config:latest
