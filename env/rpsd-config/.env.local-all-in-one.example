# rpsd-config environment for the "all services in Docker" scenario.
# Service hostnames resolve via the shared rpsd-network.
#
# This file gets copied to rpsd-config/.env.base by scripts/setup.sh.
# Override individual values in rpsd-config/.env (which takes precedence).

DEBUG=true

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],client.localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:12080,http://127.0.0.1:12080,http://client.localhost:12080

# --- config-db (container hostname) ---
POSTGRES_DB=rpsd
POSTGRES_USER=rpsd
POSTGRES_PASSWORD=rpsd
POSTGRES_HOST=config-db
POSTGRES_PORT=5432

# --- Keycloak / OIDC ---
SITE_ID=1
OIDC_PROVIDER_ID=keycloak

# Browser-facing URLs use localhost (browser → host port → container)
KEYCLOAK_DISCOVERY_URL=http://localhost:18080/realms/rapsodia/.well-known/openid-configuration
OIDC_AUTHORIZATION_ENDPOINT_URL=http://localhost:18080/realms/rapsodia/protocol/openid-connect/auth
OIDC_ISSUER_URL=http://localhost:18080/realms/rapsodia

OIDC_CLIENT_ID=django
OIDC_CLIENT_SECRET=django-secret
OIDC_FETCH_USERINFO=false
