# rpsd-config environment for the "devcontainer + rpsd shared services" scenario.
# Use this when rpsd-config runs in its own devcontainer while shared infrastructure
# (config-db, Keycloak) is managed by rpsd on the host machine.
#
# Shared services are reached via host.docker.internal (host bridge).
# On Linux devcontainers you may need to add to devcontainer.json:
#   "runArgs": ["--add-host=host.docker.internal:host-gateway"]
#
# This file gets copied to rpsd-config/.env.base by scripts/setup.sh --scenario local-devcontainer.
# Override individual values in rpsd-config/.env (which takes precedence).

DEBUG=true

# Adjust to match the port your devcontainer forwards (check devcontainer.json "forwardPorts")
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- config-db (host.docker.internal, not container hostname) ---
POSTGRES_DB=rpsd
POSTGRES_USER=rpsd
POSTGRES_PASSWORD=rpsd
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=20140

# --- Keycloak / OIDC ---
# Browser-facing URLs use localhost — same as the all-in-one scenario since
# the browser always hits the host machine port, regardless of devcontainer setup.
SITE_ID=1
OIDC_PROVIDER_ID=keycloak

KEYCLOAK_DISCOVERY_URL=http://localhost:19300/realms/rapsodia/.well-known/openid-configuration
OIDC_AUTHORIZATION_ENDPOINT_URL=http://localhost:19300/realms/rapsodia/protocol/openid-connect/auth
OIDC_ISSUER_URL=http://localhost:19300/realms/rapsodia

OIDC_CLIENT_ID=django
OIDC_CLIENT_SECRET=django-secret
OIDC_FETCH_USERINFO=false
