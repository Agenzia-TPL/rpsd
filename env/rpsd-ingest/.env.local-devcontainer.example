# rpsd-ingest environment for the "devcontainer + rpsd shared services" scenario.
# Use this when rpsd-ingest runs in its own devcontainer while shared infrastructure
# (Kafka, RabbitMQ, Prefect) is managed by rpsd on the host machine.
#
# Shared services are reached via host.docker.internal (host bridge).
# On Linux devcontainers you may need to add to devcontainer.json:
#   "runArgs": ["--add-host=host.docker.internal:host-gateway"]
#
# This file gets copied to rpsd-ingest/.env.base by scripts/setup.sh --scenario local-devcontainer.
# Override individual values in rpsd-ingest/.env (which takes precedence).

# --- Transport ---
APP__TRANSPORT__API_KEY=dev-api-key

# --- Storage ---
APP__STORAGE__PROVIDER=fs
APP__STORAGE__FS__BASE_PATH=/tmp/rpsd-storage
APP__STORAGE__COMPARE_BEFORE_SAVE=true

# --- Kafka forwarding (host.docker.internal, not container hostname) ---
# APP__FORWARD__CARRIER=kafka
# APP__FORWARD__RECIPIENT=enriched-events
# APP__FORWARD__MODE=fatheavy
# APP__FORWARD__KAFKA__BOOTSTRAP_SERVERS=host.docker.internal:19000
# APP__FORWARD__KAFKA__CLIENT_ID=rpsd-ingest

# --- RabbitMQ forwarding (alternative to Kafka) ---
# APP__FORWARD__CARRIER=rabbitmq
# APP__FORWARD__RECIPIENT=enriched-events
# APP__FORWARD__MODE=fatheavy
# APP__FORWARD__RABBITMQ__URL=amqp://guest:guest@host.docker.internal:19100/

# --- Prefect flow invocation ---
# APP__FLOW__DEPLOYMENT=ingest-flow/ingest-deployment
# PREFECT_API_URL=http://host.docker.internal:19200/api
