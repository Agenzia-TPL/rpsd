# stacks/.env.example
# Environment variables for the rpsd Docker Swarm stack.
#
# Usage:
#   cp stacks/.env.example stacks/.env
#   # Edit stacks/.env with your values
#   docker stack deploy --env-file stacks/.env -c stacks/rpsd-stack.yml rpsd
#
# This file is gitignored. Never commit stacks/.env.
#
# Docker Secrets (passwords) are NOT here — create them separately:
#   printf 'your-password' | docker secret create rpsd_keycloak_db_pass -
#   printf 'your-password' | docker secret create rpsd_keycloak_admin_pass -
#   printf 'your-password' | docker secret create rpsd_config_db_pass -
#   printf 'your-password' | docker secret create rpsd_prefect_db_pass -
#   printf 'your-password' | docker secret create rpsd_rabbitmq_pass -

# --- Image references (open mode — ghcr.io defaults) ---
# Override these to point to a private registry (managed mode).
# RPSD_IMAGE_KAFKA=ghcr.io/agenzia-tpl/kafka:3.7.0
# RPSD_IMAGE_KAFKA_UI=ghcr.io/agenzia-tpl/kafka-ui:latest
# RPSD_IMAGE_SCHEMA_REGISTRY=ghcr.io/agenzia-tpl/cp-schema-registry:latest
# RPSD_IMAGE_RABBITMQ=ghcr.io/agenzia-tpl/rabbitmq:3-management-alpine
# RPSD_IMAGE_PREFECT=ghcr.io/agenzia-tpl/prefect:3-latest
# RPSD_IMAGE_PREFECT_DB=ghcr.io/agenzia-tpl/postgres:17
# RPSD_IMAGE_PREFECT_REDIS=ghcr.io/agenzia-tpl/redis:8-alpine
# RPSD_IMAGE_KEYCLOAK=ghcr.io/agenzia-tpl/keycloak:26.3
# RPSD_IMAGE_KEYCLOAK_DB=ghcr.io/agenzia-tpl/postgres:17
RPSD_IMAGE_CONFIG_DB=ghcr.io/agenzia-tpl/rpsd-config-db:latest
RPSD_IMAGE_INGEST=ghcr.io/agenzia-tpl/rpsd-ingest:latest
RPSD_IMAGE_CONFIG=ghcr.io/agenzia-tpl/rpsd-config:latest

# --- Host ports (override if defaults conflict with your environment) ---
# RPSD_KAFKA_PORT=19000
# RPSD_KAFKA_KRAFT_PORT=19001
# RPSD_KAFKA_UI_PORT=19010
# RPSD_SCHEMA_REGISTRY_PORT=19020
# RPSD_RABBITMQ_PORT=19100
# RPSD_RABBITMQ_MGMT_PORT=19110
# RPSD_PREFECT_PORT=19200
# RPSD_KEYCLOAK_PORT=19300
# RPSD_CONFIG_DB_PORT=20140
# RPSD_INGEST_PORT=20000
# RPSD_CONFIG_PORT=20100

# --- Keycloak ---
# RPSD_KEYCLOAK_DB_NAME=keycloak
# RPSD_KEYCLOAK_DB_USER=keycloak
# RPSD_KEYCLOAK_ADMIN_USER=admin
# External URL where Keycloak is reachable (used by the Keycloak container for redirects):
RPSD_KEYCLOAK_HOSTNAME=http://your-swarm-host:19300

# --- config-db ---
# RPSD_CONFIG_DB_NAME=rpsd
# RPSD_CONFIG_DB_USER=rpsd

# --- Prefect ---
# RPSD_PREFECT_DB_USER=prefect
# RPSD_PREFECT_DB_NAME=prefect
# Full connection URL including password (reads the secret from an env var here — set to actual value):
RPSD_PREFECT_DB_URL=postgresql+asyncpg://prefect:CHANGE_ME@prefect-db:5432/prefect
# External URL where the Prefect API is reachable (used by Prefect workers/agents):
RPSD_PREFECT_API_URL=http://your-swarm-host:19200/api

# --- RabbitMQ ---
# RPSD_RABBITMQ_USER=guest
