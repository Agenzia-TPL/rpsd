# Keycloak shared service overrides (optional)
# Most settings are in compose/shared-keycloak.yml with sensible defaults.

# RPSD_KEYCLOAK_PORT=19300
# RPSD_KEYCLOAK_DB_NAME=keycloak
# RPSD_KEYCLOAK_DB_USER=keycloak
# RPSD_KEYCLOAK_DB_PASS=keycloak
# RPSD_KEYCLOAK_ADMIN_USER=admin
# RPSD_KEYCLOAK_ADMIN_PASS=admin
